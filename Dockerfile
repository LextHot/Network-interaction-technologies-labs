# Базовый образ с легкой версией Python
FROM python:3.11-slim

# Установка рабочей директории внутри контейнера
WORKDIR /app

# Отключение буферизации вывода (логи сразу в терминале)
ENV PYTHONUNBUFFERED=1

# Копирование файла зависимостей и их установка
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копирование исходного кода проекта
COPY . .

# Порт, который слушает приложение
EXPOSE 8000

# Запуск сервера с привязкой ко всем интерфейсам (0.0.0.0 обязателен для Docker)
CMD ["uvicorn", "Lab2:app", "--host", "0.0.0.0", "--port", "8000"]